{
  "bronze_root": "/user/cloudera/chu/bronze",
  "runs_root": "/user/cloudera/chu/silver_runs",
  "keys_root": "/user/cloudera/chu/technical_keys",
  "small_file_limit_bytes": 8388608,
  "max_communes_driver": 50000,
  "shuffle_partitions": 16,
  "output_partitions": {
    "diagnostic": 2,
    "specialite": 1,
    "codes_postaux": 2,
    "commune": 2,
    "region": 1,
    "patient": 4,
    "professionnel": 8,
    "etablissement": 4,
    "activite": 8,
    "consultation": 8,
    "hospitalisation": 1,
    "satisfaction": 1,
    "deces": 16,
    "defunt": 16
  },
  "region_aliases": {
    "PACA": "Provence-Alpes-Cote d'Azur",
    "IDF": "Ile-de-France"
  },
  "sources": {
    "diagnostic": {
      "path": "postgres/diagnostic/diagnostic.txt",
      "delimiter": ";",
      "encoding": "utf-8",
      "header": false,
      "columns": [
        "Code_diag",
        "Diagnostic"
      ]
    },
    "specialite": {
      "path": "postgres/specialites/specialites.txt",
      "delimiter": ";",
      "encoding": "utf-8",
      "header": false,
      "columns": [
        "Code_specialite",
        "Fonction",
        "Specialite"
      ]
    },
    "patient": {
      "path": "postgres/patients/patients.txt",
      "delimiter": ";",
      "encoding": "utf-8",
      "header": false,
      "columns": [
        "Id_patient",
        "Nom",
        "Prenom",
        "Sexe",
        "Adresse",
        "Ville",
        "Code_postal",
        "Pays",
        "EMail",
        "Tel",
        "Date",
        "Age",
        "Num_Secu",
        "Groupe_sanguin",
        "Poid",
        "Taille"
      ]
    },
    "professionnel": {
      "path": "postgres/professionnels/professionnels.txt",
      "delimiter": ";",
      "encoding": "utf-8",
      "header": false,
      "columns": [
        "Identifiant",
        "Civilite",
        "Categorie_professionnelle",
        "Nom",
        "Prenom",
        "Profession",
        "Type_identifiant",
        "Code_specialite"
      ]
    },
    "consultation": {
