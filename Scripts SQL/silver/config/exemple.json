      "delimiter": ";",
      "encoding": "utf-8",
      "required": [
        "identifiant",
        "identifiant_organisation",
        "mode_exercice"
      ]
    },
    "hospitalisation": {
      "path": "csv_sante/Hospitalisations.csv",
      "delimiter": ";",
