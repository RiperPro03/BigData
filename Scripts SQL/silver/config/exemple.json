        "Id_mut",
        "Id_patient",
        "Id_prof_sante",
        "Code_diag",
        "Motif",
        "Date",
        "Heure_debut",
        "Heure_fin"
      ]
    },
    "etablissement": {
      "path": "etablissements/etablissement_sante.csv",
      "delimiter": ";",
