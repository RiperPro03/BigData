      "delimiter": ",",
      "encoding": "utf-8",
      "required": [
        "TYPECOM",
        "COM",
        "REG",
        "DEP",
        "LIBELLE",
        "COMPARENT"
      ]
    },
    "cog_regions": {
      "path": "referentiels_geographiques/v_region_2024.csv",
      "delimiter": ",",
      "encoding": "utf-8",
      "required": [
        "REG",
        "LIBELLE"
      ]
    }
  }
}
