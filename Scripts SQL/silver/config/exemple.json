        "code_postal",
        "adresse",
        "cedex",
        "complement_destinataire",
        "complement_point_geographique",
        "email",
        "enseigne_commerciale_site",
        "indice_repetition_voie",
        "mention_distribution",
        "numero_voie",
        "pays",
        "siren_site",
        "siret_site",
        "telecopie",
        "telephone",
        "telephone_2",
        "type_voie",
        "voie"
      ]
    },
    "activite": {
